{
  "name": "marbles-root",
  "version": "1.0.0",
  "private": true,
  "description": "IE Marbles (India) & KSD Homes (Australia) Full Stack",
  "scripts": {
    "start": "node run.js",
    "dev": "node run.js",
    "server": "npm --prefix server start",
    "india": "npm --prefix India run dev",
    "australia": "npm --prefix Australia run dev",
    "admin": "npm --prefix admin run dev",
    "build:india": "npm --prefix India run build",
    "build:australia": "npm --prefix Australia run build",
