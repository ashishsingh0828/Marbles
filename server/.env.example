# Server Port
PORT=5050

# ---- MongoDB Configuration -------------------------------------------
# Local: mongodb://127.0.0.1:27017/marbleDB
# Atlas: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/marbleDB?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/marbleDB?retryWrites=true&w=majority&appName=Cluster0

# ---- Authentication & Security ---------------------------------------
# Use a long, cryptographically random string (e.g. generate via `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`)
JWT_SECRET=your_jwt_secret_key_here

# ---- Initial Master Admin Credentials --------------------------------
# Auto-created on first database bootstrap/seed if no admin exists
ADMIN_EMAIL=admin@marble.com
ADMIN_PASSWORD=your_secure_admin_password_here

# ---- Multi-Region & Managed Sites -----------------------------------
# Comma-separated list of managed frontend domains/regions
SITES=india,australia

# Admin Panel Location (used for constructing reset links and redirects)
ADMIN_URL=http://localhost:3002

# Allowed CORS Origins (India Vite: 3000, Australia Vite: 3001, Admin: 3002)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ---- Mail Delivery / SMTP (Notifications & Reset Password) ----------
# Leave SMTP_HOST empty to log reset tokens and form leads directly to console in dev mode
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@marble.com

# Recipient email for contact/quote leads
NOTIFICATION_EMAIL=admin@marble.com